tt_content.teaser-hero >
tt_content.teaser-hero =< handlebarsContent.default
tt_content.teaser-hero {
  templateName = @ce-hero-teaser

  dataProcessing {
    5 = ceTextMedia
    5 {
      settings {
        fieldConfig {
          assets {
            youtube {
              width = 0
              height = 0
              controls = 1
              no-cookie = 1
              modestbranding = 1
              loop = 1
              relatedVideos = 0
              enablejsapi = 0

              labels {
                accessibility = LLL:EXT:bravo_handlebars_content/Resources/Private/Language/locallang.xlf:accessibility.video.play
                textHTML = LLL:EXT:bravo_handlebars_content/Resources/Private/Language/locallang.xlf:text.media.cookie_disclaimer
              }

              previewImage {
                width = 320
                height = 180
                loading = lazy
                // imgResource config
                variants {
                  desktop {
                    file.maxW = 1280
                  }

                  tablet {
                    file.maxW = 640
                  }

                  mobile {
                    file.maxW = 320
                  }
                }
              }
            }

            vimeo {
              width = 0
              height = 0
              controls = 1
              no-cookie = 1
              modestbranding = 1
              loop = 1
              relatedVideos = 0
              enablejsapi = 0

              labels {
                accessibility = LLL:EXT:bravo_handlebars_content/Resources/Private/Language/locallang.xlf:accessibility.video.play
                textHTML = LLL:EXT:bravo_handlebars_content/Resources/Private/Language/locallang.xlf:text.media.cookie_disclaimer
              }

              previewImage {
                width = 320
                height = 180
                loading = lazy
                // imgResource config
                variants {
                  desktop {
                    file.maxW = 1280
                  }

                  tablet {
                    file.maxW = 640
                  }

                  mobile {
                    file.maxW = 320
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

