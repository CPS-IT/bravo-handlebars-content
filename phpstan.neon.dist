# Include TYPO3 specific rules if available
# includes:
#     - phar://vendor/phpstan/phpstan/phpstan.phar/conf/bleedingEdge.neon

includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - Classes
        - Tests
    excludePaths:
        - Tests/Fixtures
    ignoreErrors:
        # Allow mixed return types for TYPO3 data processors
        - "#Method .* should return .* but returns mixed#"
        # Allow TYPO3 core dependencies without strict typing
        - "#Call to an undefined method TYPO3\\\\CMS\\\\Core\\\\.*::#"
        # Allow TYPO3 internal class usage
        - "#.* has typehint with internal class TYPO3\\\\CMS\\\\.*#"
        - "#.* references internal class TYPO3\\\\CMS\\\\.*#"
        # Allow uninitialized properties in test classes (initialized in setUp)
        - "#Class .* has an uninitialized property .*#"
        # Allow array types without value specification for TYPO3 compatibility
        - "#.* has no value type specified in iterable type array#"
        - "#.* has parameter .* with no value type specified in iterable type array#"
        - "#.* return type has no value type specified in iterable type array#"
        - "#has parameter .* with no type specified#"
        - "#Call to an undefined method .*MockObject.*#"
        # Allow PHPUnit mock object types
        - "#PHPUnit\\\\Framework\\\\MockObject\\\\MockObject.*given#"
        # Allow undefined methods on mock objects
        - "#Call to an undefined method .*MockObject::expects\\(\\)#"
        # Allow TYPO3 internal class access
        - "#Call to method .* of internal class TYPO3\\\\CMS\\\\.*#"
        - "#Catching internal class TYPO3\\\\CMS\\\\.*#"
        - "#Access to constant on internal class TYPO3\\\\CMS\\\\.*#"
        # Allow PHPUnit assertion optimizations
        - "#Call to static method PHPUnit\\\\Framework\\\\Assert::.*will always evaluate to.*#"
    reportUnmatchedIgnoredErrors: false

    # TYPO3 specific configuration
    bootstrapFiles:
        - vendor/autoload.php

    # Memory and performance settings
    tmpDir: var/phpstan

    # Type coverage
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    checkImplicitMixed: false

    parallel:
        jobSize: 20
        maximumNumberOfProcesses: 8
        minimumNumberOfJobsPerProcess: 2
