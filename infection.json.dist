{
    "$schema": "https://raw.githubusercontent.com/infection/infection/master/resources/schema.json",
    "source": {
        "directories": [
            "Classes"
        ],
        "excludes": [
            "Classes/Exception"
        ]
    },
    "timeout": 60,
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection.json",
        "perMutator": "var/infection/per-mutator.md"
    },
    "tmpDir": "var/infection/tmp",
    "phpUnit": {
        "configDir": "Tests/Build/phpunit",
        "customPath": "vendor/bin/phpunit"
    },
    "mutators": {
        "@default": true,
        "@function_signature": false,
        "ArrayItemRemoval": {
            "ignore": [
                "Cpsit\\BravoHandlebarsContent\\Configuration\\*"
            ]
        },
        "MethodCallRemoval": {
            "ignore": [
                "Cpsit\\BravoHandlebarsContent\\DataProcessing\\*::process"
            ]
        },
        "PublicVisibility": false,
        "ProtectedVisibility": false
    },
    "testFramework": "phpunit",
    "bootstrap": "vendor/typo3/testing-framework/Resources/Core/Build/UnitTestsBootstrap.php",
    "initialTestsPhpOptions": "-d memory_limit=1024M",
    "testFrameworkOptions": "--configuration=Tests/Build/phpunit/UnitTests.xml --testsuite=Unit",
    "minMsi": 85,
    "minCoveredMsi": 90,
    "ignoreMsiWithNoMutations": false,
    "noProgress": false,
    "threads": 4,
    "dryRun": false
}
