# TypoScript configuration for functional tests
# This file provides minimal TypoScript setup for testing handlebars content processing

config {
  no_cache = 1
  debug = 1
  admPanel = 0
  disableAllHeaderCode = 1
  sendCacheHeaders = 0
}

# Configure basic page
page = PAGE
page {
  config {
    doctype = html5
    removeDefaultJS = 1
    removeDefaultCss = 1
    disablePrefixComment = 1
  }

  10 = CONTENT
  10 {
    table = tt_content
    select {
      where = colPos=0
    }
  }
}

# Content element configuration
tt_content {
  default = < lib.contentElement
  text < lib.contentElement
  text {
    templateName = @ce-text
    dataProcessing {
      10 = ceText
      10 {
        as = textData
      }
    }
  }

  textmedia < lib.contentElement
  textmedia {
    templateName = @ce-textmedia
    dataProcessing {
      10 = ceTextMedia
      10 {
        as = mediaData
      }
      20 = handlebarsMedia
      20 {
        as = processedMedia
      }
    }
  }
}

# Base content element configuration
lib.contentElement = HANDLEBARSTEMPLATE
lib.contentElement {
  templateName = @ce-default
  templateRootPaths {
    10 = EXT:bravo_handlebars_content/Resources/Private/Templates/
  }
  partialRootPaths {
    10 = EXT:bravo_handlebars_content/Resources/Private/Partials/
  }
  layoutRootPaths {
    10 = EXT:bravo_handlebars_content/Resources/Private/Layouts/
  }
}

# Data processor configurations for testing
dataProcessing {
  ceText = Cpsit\BravoHandlebarsContent\DataProcessing\TextDataProcessor
  ceTextMedia = Cpsit\BravoHandlebarsContent\DataProcessing\TextMediaDataProcessor
  handlebarsMedia = Cpsit\BravoHandlebarsContent\DataProcessing\MediaProcessor
}
